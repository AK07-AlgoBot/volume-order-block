# Copy this file to the repository root as `.env` for Docker Compose.

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=480
PRODUCTION_DOMAIN=ak07.in

# First-time seed only: if users_auth.json has no AK07 row yet, this sets the password hash.
# Data volume path: src/server/data/users_auth.json
AK07_PASSWORD=change-me-rotate-for-production

AK07_PAPER_TRADING=1
AK07_POLL_SECONDS=15

# IST session schedule (engine reads these on startup)
AK07_TOKEN_REFRESH_IST=08:45
AK07_ENTRY_OPEN_IST=09:20


TELEGRAM_BOT_TOKEN="8376419713:AAENJb_Rta0qBA1ypZsHZvkfOqSWTGP256Y"
TELEGRAM_CHAT_ID=-5105991026


DASHBOARD_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,https://ak07.in,http://ak07.in

DASHBOARD_RESTART_BOT_ON_SAVE=0
