# Copy this file to the repository root as `.env` for Docker Compose.

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=480
PRODUCTION_DOMAIN=ak07.in

# First-time seed only: if users_auth.json has no AK07 row yet, this sets the password hash.
# Data volume path: src/server/data/users_auth.json
AK07_PASSWORD=change-me-rotate-for-production

AK07_PAPER_TRADING=0
AK07_POLL_SECONDS=15

# IST session schedule (engine reads these on startup)
AK07_TOKEN_REFRESH_IST=08:45
AK07_ENTRY_OPEN_IST=09:20
# Max OI walls: only strikes within this many points of spot (fallback: full chain)
AK07_OI_BAND_POINTS=500
# Min heavyweight quotes required before component bias is BULLISH/BEARISH
AK07_COMPONENT_BIAS_MIN_KNOWN=2

# Strategy Type 2 — SMC+CRT (Nifty only, 1 lot options)
SMC_CRT_POLL_SECONDS=15
SMC_CRT_CRT_START_IST=09:15
SMC_CRT_SESSION_END_IST=15:30
SMC_CRT_SQUARE_OFF_IST=14:55

# Strategy Type 3 — BLR Breakout (separate engine service)
BREAKOUT_POLL_SECONDS=15
BREAKOUT_SESSION_START_IST=09:15
BREAKOUT_ENTRY_START_IST=09:20
BREAKOUT_NO_ENTRY_AFTER_IST=15:00
BREAKOUT_SQUARE_OFF_IST=15:15
BREAKOUT_SESSION_END_IST=15:30
BREAKOUT_MAX_TRADES_PER_DAY=2
BREAKOUT_SL_BUFFER_PTS=2

# Session archives for Performance Review (Docker volume path)
# AK07_ARCHIVE_DIR=/app/src/server/data/archive


TELEGRAM_BOT_TOKEN="8376419713:AAENJb_Rta0qBA1ypZsHZvkfOqSWTGP256Y"
TELEGRAM_CHAT_ID=-5105991026


DASHBOARD_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,https://ak07.in,http://ak07.in

DASHBOARD_RESTART_BOT_ON_SAVE=0
