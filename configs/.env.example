# Copy this file to the repository root as `.env` for Docker Compose.

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=480
PRODUCTION_DOMAIN=ak07.in

# First-time seed only: if users_auth.json has no AK07 row yet, this sets the password hash.
# Data volume path: src/server/data/users_auth.json
AK07_PASSWORD=change-me-rotate-for-production

AK07_PAPER_TRADING=0
AK07_POLL_SECONDS=15

# Upstox day P&L — polled for cockpit display. Set guard=1 to block bot entries at INR targets.
AK07_DAILY_PROFIT_GUARD_ENABLED=0
AK07_PROFIT_GUARD_POLL_SEC=5
# AK07_DAILY_TARGET_EXPIRY_INR=3000
# AK07_DAILY_TARGET_FIRST_TRADE_INR=3000
# AK07_DAILY_TARGET_NORMAL_INR=5000

# IST session schedule (engine reads these on startup)
AK07_TOKEN_REFRESH_IST=06:00
AK07_ENTRY_OPEN_IST=09:20
AK07_NO_ENTRY_AFTER_IST=14:45
# Max OI walls: only strikes within this many points of spot (fallback: full chain)
AK07_OI_BAND_POINTS=500
# Min heavyweight quotes required before component bias is BULLISH/BEARISH
AK07_COMPONENT_BIAS_MIN_KNOWN=2

# NSE lot sizes (revised Dec 30 2025 EOD — effective Jan 2026 expiries onward)
# AK07_LOT_SIZE_NIFTY=65
# AK07_LOT_SIZE_BANKNIFTY=30
# AK07_LOT_SIZE_SENSEX=20

# Strategy Type 1 — AK07 OI (2 lots: book 1 at partial, exit remainder at full target)
# Optional OI scanner gates (off by default — pocket + wick is primary filter)
# AK07_OI_VELOCITY_GATE=0
# AK07_OI_PCR_GATE=0
# AK07_OI_SL_PTS_NIFTY=30
# AK07_OI_PARTIAL_PTS_NIFTY=30
# AK07_OI_TARGET_PTS_NIFTY=60
# AK07_OI_SL_PTS_BANKNIFTY=30
# AK07_OI_PARTIAL_PTS_BANKNIFTY=30
# AK07_OI_TARGET_PTS_BANKNIFTY=60
# AK07_OI_SL_PTS_SENSEX=60
# AK07_OI_PARTIAL_PTS_SENSEX=60
# AK07_OI_TARGET_PTS_SENSEX=120

# Strategy Type 2 — SMC+CRT (Nifty only, 1 lot options)
SMC_CRT_POLL_SECONDS=15
SMC_CRT_CRT_START_IST=09:15
SMC_CRT_SESSION_END_IST=15:30
SMC_CRT_SQUARE_OFF_IST=14:55
SMC_CRT_NO_ENTRY_AFTER_IST=14:45

# Strategy Type 3 — BLR Breakout (separate engine service)
BREAKOUT_POLL_SECONDS=15
BREAKOUT_SESSION_START_IST=09:15
# TV parity: Upstox candle open = NSE auction price; capture live LTP at 9:15 instead.
BREAKOUT_SESSION_OPEN_POLL_SECONDS=1
BREAKOUT_SESSION_OPEN_PRESTART_SEC=10
BREAKOUT_SESSION_OPEN_TICK_MAX_DELAY_SEC=45
BREAKOUT_SESSION_OPEN_TICK_WINDOW_SEC=120
BREAKOUT_SESSION_OPEN_WAIT_FOR_TICK=1
BREAKOUT_AUCTION_LTP_TOLERANCE_PTS=1.5
BREAKOUT_ENTRY_START_IST=09:20
BREAKOUT_NO_ENTRY_AFTER_IST=13:00
BREAKOUT_SQUARE_OFF_IST=14:55
BREAKOUT_SESSION_END_IST=15:30
BREAKOUT_MAX_TRADES_PER_DAY=3
BREAKOUT_SL_BUFFER_PTS=2
# Sizing trial (Pine v8 Fixed SL and TP): 30 SL / 60 TP, 1:2 R:R. Use band for legacy.
BREAKOUT_SIZING_MODE=fixed_sl_tp
BREAKOUT_FIXED_SL_PTS=30
BREAKOUT_FIXED_TP_PTS=60
# Friday S3: book at 1:1 (TP1 = SL pts, default 30) instead of 1:2 (60).
BREAKOUT_FRIDAY_1TO1_TP=1
# Live Pine: stop entries after 1st trade hits target (0 = off for live trial)
BREAKOUT_STOP_AFTER_FIRST_TP=0
# Optional: filter wick-only spikes (directional body >= 35% of candle range). 0 = live default.
BREAKOUT_MIN_BODY_RATIO=0
# Day review side filter (Review LONG/SHORT) — off to match Pine
BREAKOUT_DAY_REVIEW_ENABLED=0
BREAKOUT_TP1_PTS_NIFTY=30
BREAKOUT_TP1_PTS_BANKNIFTY=30
BREAKOUT_TP1_PTS_SENSEX=100
BREAKOUT_SENSEX_COST_SL_PTS=50
# Live trial: NIFTY only. BLR still published for all indices (S2 filter).
BREAKOUT_ENTRIES_ENABLED=1
BREAKOUT_ENTRIES_INDICES=NIFTY
# BLR band half-width (% of 9:15 open) — Pine v6 defaults
BREAKOUT_BAND_PCT_NIFTY=0.211
BREAKOUT_BAND_PCT_BANKNIFTY=0.125
BREAKOUT_BAND_PCT_SENSEX=0.14
BREAKOUT_GAP_EXTRA_PCT=0

# Groww FNO: MARKET orders can be RMS-rejected (LPP breach). LIMIT at LTP is default.
GROWW_FNO_ORDER_TYPE=LIMIT
GROWW_LIMIT_SLIPPAGE_PTS=2
GROWW_ORDER_STATUS_POLLS=4
GROWW_ORDER_STATUS_POLL_SEC=1

# Strategy Type 4 — Advanced Price Action (Nifty · BankNifty · Sensex)
PA_POLL_SECONDS=15
PA_SESSION_START_IST=09:15
PA_OR_END_IST=09:30
PA_ENTRY_START_IST=09:35
PA_NO_ENTRY_AFTER_IST=14:45
PA_SQUARE_OFF_IST=14:55
PA_SESSION_END_IST=15:30
PA_MAX_TRADES_PER_DAY=2

# Strategy Type 5 — Advanced Greeks (Nifty · BankNifty · Sensex chain analytics)
GREEKS_POLL_SECONDS=15
GREEKS_SESSION_START_IST=09:15
GREEKS_ENTRY_START_IST=09:25
GREEKS_NO_ENTRY_AFTER_IST=14:45
GREEKS_SQUARE_OFF_IST=14:55
GREEKS_SESSION_END_IST=15:30
GREEKS_MAX_TRADES_PER_DAY=2
GREEKS_SKEW_ENTRY_PCT=1.0
# Fixed spot SL/TP (Strategy 5 — same defaults as Strategy 3 book levels)
# AK07_FIXED_TP1_PTS_NIFTY=30
# AK07_FIXED_TP1_PTS_BANKNIFTY=30
# AK07_FIXED_TP1_PTS_SENSEX=100
# AK07_FIXED_SL_PTS_NIFTY=30
# AK07_FIXED_SL_PTS_BANKNIFTY=30
# AK07_FIXED_SL_PTS_SENSEX=60

# Strategy Type 6 — Intraday S/R Reversal (prior 1H swing H/L @ 09:15 + today session)
SR_POLL_SECONDS=15
SR_SESSION_START_IST=09:15
SR_OR_END_IST=09:30
SR_ENTRY_START_IST=09:35
SR_NO_ENTRY_AFTER_IST=14:45
SR_SQUARE_OFF_IST=14:55
SR_SESSION_END_IST=15:30
SR_MAX_TRADES_PER_DAY=2
SR_PRIOR_SWING_LOOKBACK_DAYS=30
SR_ZONE_TOLERANCE_PTS=20
SR_WICK_RATIO=0.42
SR_SL_BUFFER_PTS=3.0

# ── Strategy 7 — VWAP Momentum Breakout (VMB) ────────────────────────────────
S7_CAPITAL_INR=500000          # working capital in INR for position sizing
S7_RISK_PCT=1.0                # % of capital risked per trade (1 ATR = this amount)
S7_DAILY_LOSS_LIMIT_PCT=2.0    # engine pauses for the day after this % loss
S7_MAX_LOTS=2                  # hard cap on lots per trade
S7_ATR_PERIOD=14               # ATR lookback in 5m bars
S7_ATR_SL_MULT=1.0             # SL = entry ∓ ATR × this
S7_ATR_TP1_MULT=1.5            # TP1 = entry ± ATR × this (guaranteed 1.5R)
S7_BODY_RATIO=0.40             # min candle body / range ratio (filter dojis)
S7_VWAP_SLOPE_BARS=4           # VWAP slope lookback in bars
S7_SL_BUFFER_PTS=2.0           # extra buffer added to ATR SL
S7_MAX_TRADES_PER_DAY=1        # max trades per index per day
S7_NO_ENTRY_AFTER_IST=13:30    # no new entries after this time
S7_POLL_SECONDS=15             # live engine poll interval

# Kite Connect OAuth — register redirect URL on https://developers.kite.trade/
# Production (ak07.in): auto-resolves to https://ak07.in/api/brokers/kite/callback when PRODUCTION_DOMAIN is set.
# KITE_REDIRECT_URL=https://ak07.in/api/brokers/kite/callback
# AK07_COCKPIT_URL=https://ak07.in
# AK07_API_PUBLIC_URL=https://ak07.in
# AK07_LOCAL_DEV=1
# KITE_REDIRECT_URL=http://127.0.0.1:8080/api/brokers/kite/callback
# CHOCH_BE_RR=1.0              # move SL to scratch only after 1R MFE (was 0.5R)
# CHOCH_BE_BUFFER_PTS=2.0        # scratch stop distance from entry once BE triggers

# Session archives for Performance Review (Docker volume path)
# AK07_ARCHIVE_DIR=/app/src/server/data/archive


TELEGRAM_BOT_TOKEN="8376419713:AAENJb_Rta0qBA1ypZsHZvkfOqSWTGP256Y"
TELEGRAM_CHAT_ID=-5105991026
# Telegram policy: 1 = alerts only for AK07 admin channel (default); 0 = future per-user fan-out
AK07_TELEGRAM_ADMIN_ONLY=1


DASHBOARD_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,https://ak07.in,http://ak07.in

DASHBOARD_RESTART_BOT_ON_SAVE=0
