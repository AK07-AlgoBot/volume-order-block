FROM python:3.12-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc git ca-certificates curl gnupg \
    && install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
    && chmod a+r /etc/apt/keyrings/docker.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian bookworm stable" > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends docker-ce-cli docker-compose-plugin \
    && rm -rf /var/lib/apt/lists/*

COPY src/server/requirements.txt src/server/requirements.txt
COPY requirements.txt requirements.txt
RUN pip install --no-cache-dir -r src/server/requirements.txt -r requirements.txt

COPY src/server/ src/server/
COPY src/bot/ src/bot/
COPY src/lib/ src/lib/
COPY scripts/ scripts/
COPY .streamlit/ .streamlit/

ENV PYTHONPATH=/app/src/server/src

EXPOSE 8000 8501 8765

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
