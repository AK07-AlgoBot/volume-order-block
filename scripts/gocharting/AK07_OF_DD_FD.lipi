indicator("AK07 OF BuySell", overlay = true)

// Video playbook: 1 DD  2 FD  3 Option bullish  4 Stacked option buy
// Apply on 5m NIFTY-I and BANKNIFTY-I footprint (same file; price picks scale).
// (bar-level 1:3 proxy; Lipi has no price-level stack rows).

nearZeroAbs = input(600.0, title = "Near-zero floor |delta| (both indices)")
oppFrac = input(25.0, title = "Opp extreme vs |delta| pct")
// Video Full Delta: rare sudden marubozu where delta~max/min~COT, big vol, not day H/L, at location.
similarPct = input(8.0, title = "FD similarity pct (video: tight)")
bigVolMult = input(2.0, title = "FD/STACK big vol vs SMA")
volSmaLen = input(20, title = "Vol SMA len")
maruBodyPct = input(85.0, title = "FD maru body pct")
maruWickPct = input(8.0, title = "FD max wick pct")
fdMinAbs = input(800.0, title = "FD min |delta| (Nifty; BN auto x2)")
locTolPts = input(25.0, title = "Nifty location touch (pts)")
fibMinBars = input(6, title = "Min bars into the day for Fib")
runFibMin = input(3, title = "Video run Fib min same-color bars")
imbRatio = input(3.0, title = "STACK buy/sell vol ratio")
stackNeed = input(3, title = "STACK consecutive imb bars")
maxTradesDay = input(8, title = "Max signals/day (0=off)")
chartIsOpt = input(false, title = "This chart is CE/PE (enables OB)")
enableDD = input(true, title = "1 Enable DD")
enableFD = input(true, title = "2 Enable FD")
enableOB = input(false, title = "3 Enable Option Bullish (CE/PE chart only)")
enableST = input(false, title = "4 Enable Stacked (bar proxy)")
requireLoc = input(false, title = "DD require Fib location (off = mid-day DD OK)")
requireLocFD = input(true, title = "FD require location (video)")
banExactDay = input(true, title = "Ban exact day H/L bounce (video)")

d = orderflow.delta
maxD = orderflow.maxdelta
minD = orderflow.mindelta
cotH = orderflow.cothigh
cotL = orderflow.cotlow
buyV = orderflow.buyvolume
sellV = orderflow.sellvolume

bull = close > open
bear = close < open
tick = 0.05
rng = math.max(high - low, tick)
// Same script on NIFTY-I and BANKNIFTY-I (price picks the scale).
isBN = close > 40000
locTol = isBN ? locTolPts * 1.6 : locTolPts * 0.7
nearZ = math.max(nearZeroAbs, math.abs(d) * oppFrac / 100.0)
bodyPct = 100.0 * math.abs(close - open) / rng
upWickPct = 100.0 * (high - math.max(open, close)) / rng
dnWickPct = 100.0 * (math.min(open, close) - low) / rng
maruBull = bull and bodyPct >= maruBodyPct and upWickPct <= maruWickPct and dnWickPct <= maruWickPct
maruBear = bear and bodyPct >= maruBodyPct and upWickPct <= maruWickPct and dnWickPct <= maruWickPct
volSma = talib.sma(volume, volSmaLen)
bigOrder = volume >= volSma * bigVolMult
lowerHalf = close <= (high + low) / 2.0
upperHalf = close >= (high + low) / 2.0

m3 = (math.abs(d) + math.abs(maxD) + math.abs(cotL)) / 3.0
similarBuy = m3 > tick and math.abs(d - maxD) <= m3 * similarPct / 100.0 and math.abs(d - cotL) <= m3 * similarPct / 100.0 and math.abs(maxD - cotL) <= m3 * similarPct / 100.0
m3s = (math.abs(d) + math.abs(minD) + math.abs(cotH)) / 3.0
similarSell = m3s > tick and math.abs(d - minD) <= m3s * similarPct / 100.0 and math.abs(d - cotH) <= m3s * similarPct / 100.0 and math.abs(minD - cotH) <= m3s * similarPct / 100.0

inSess = (hour == 9 and minute >= 15) or (hour > 9 and hour < 15) or (hour == 15 and minute <= 30)
newDay = dayofweek != dayofweek[1] or (hour == 9 and minute == 15 and minute[1] != 15)

// Current-day swing Fib (not candle-run). Scan today's 5m bars:
// if the day high is more recent than the day low, swing is low->high
// (buy pullback at 0.6-0.7). If the day low is more recent, swing is
// high->low (sell bounce at 0.6-0.7).
dayHi = high
dayLo = low
hiAgo = 0.0
loAgo = 0.0
nToday = 0.0
for i = 1 to 75 {
    if dayofweek[i] != dayofweek {
        break
    }
    nToday := nToday + 1.0
    if high[i] > dayHi {
        dayHi := high[i]
        hiAgo := nToday
    }
    if low[i] < dayLo {
        dayLo := low[i]
        loAgo := nToday
    }
}
atDayHi = math.abs(high - dayHi) <= locTol
atDayLo = math.abs(low - dayLo) <= locTol
dayRng = math.max(dayHi - dayLo, tick)
minDayRng = isBN ? 80.0 : 30.0
upSwing = hiAgo <= loAgo
fib6 = upSwing ? dayHi - 0.6 * dayRng : dayLo + 0.6 * dayRng
fib7 = upSwing ? dayHi - 0.7 * dayRng : dayLo + 0.7 * dayRng
useFib = nToday >= fibMinBars and dayRng >= minDayRng
inFib67 = useFib and close <= math.max(fib6, fib7) + locTol and close >= math.min(fib6, fib7) - locTol

dipLow = high >= dayHi and close < high and low < low[1]
dipHigh = low <= dayLo and close > low and high > high[1]
revLo = atDayLo and bull and dnWickPct >= 25.0
revHi = atDayHi and bear and upWickPct >= 25.0
nearDip = dipLow or dipHigh or revLo or revHi or dipLow[1] or dipHigh[1] or revLo[1] or revHi[1]
atEdge = atDayHi or atDayLo
midZone = not atEdge and not inFib67 and not nearDip
goodLocLong = inFib67 and upSwing
goodLocShort = inFib67 and not upSwing
// Video locations for FD: Fib 0.6-0.7, dip after break, or edge (not naked mid-range).
fdLocLong = goodLocLong or nearDip or (atEdge and not midZone)
fdLocShort = goodLocShort or nearDip or (atEdge and not midZone)
dayOpen = open
biasUp = close > dayOpen
locOkLong = not requireLoc or goodLocLong
locOkShort = not requireLoc or goodLocShort
locOkOB = not requireLoc or inFib67
fdLocOkLong = not requireLocFD or fdLocLong
fdLocOkShort = not requireLocFD or fdLocShort
bounceBanLong = banExactDay and atDayLo and not inFib67 and not nearDip
bounceBanShort = banExactDay and atDayHi and not inFib67 and not nearDip

canSignal = maxTradesDay > -1
fdFloor = isBN ? fdMinAbs * 2.0 : fdMinAbs

// 1) Delta divergence (video) - primary / most frequent
ddBuyRaw = enableDD and inSess and bull and d < 0 and minD < 0 and math.abs(maxD) <= nearZ
ddSellRaw = enableDD and inSess and bear and d > 0 and maxD > 0 and math.abs(minD) <= nearZ
ddBuy = ddBuyRaw and canSignal and locOkLong and not bounceBanLong
ddSell = ddSellRaw and canSignal and locOkShort and not bounceBanShort

// 2) Full delta (video) - SUDDEN first marubozu only (not a run of same-colour marus),
//    delta~max/min~COT, big volume, not exact day H/L, at location.
priorMaruLong1 = close[1] > open[1] and (100.0 * math.abs(close[1] - open[1]) / math.max(high[1] - low[1], tick)) >= maruBodyPct * 0.9
priorMaruLong2 = close[2] > open[2] and (100.0 * math.abs(close[2] - open[2]) / math.max(high[2] - low[2], tick)) >= maruBodyPct * 0.9
priorMaruShort1 = close[1] < open[1] and (100.0 * math.abs(close[1] - open[1]) / math.max(high[1] - low[1], tick)) >= maruBodyPct * 0.9
priorMaruShort2 = close[2] < open[2] and (100.0 * math.abs(close[2] - open[2]) / math.max(high[2] - low[2], tick)) >= maruBodyPct * 0.9
suddenBuy = not priorMaruLong1 and not priorMaruLong2
suddenSell = not priorMaruShort1 and not priorMaruShort2
fdBuy = enableFD and inSess and canSignal and maruBull and bigOrder and similarBuy and math.abs(d) >= fdFloor and not atDayHi and not atDayLo and suddenBuy and fdLocOkLong and not bounceBanLong
fdSell = enableFD and inSess and canSignal and maruBear and bigOrder and similarSell and math.abs(d) >= fdFloor and not atDayHi and not atDayLo and suddenSell and fdLocOkShort and not bounceBanShort

// 3) Option bullish - futures vs ATM option colour mismatch
// Lipi cannot pull a second symbol (request.security is not usable here).
// Apply this same script on the option 5m chart: green option bar at a valid
// location is the chart-local OB (video: buy that option).
onOpt = chartIsOpt
obRaw = enableOB and inSess and bull and onOpt
obBuy = obRaw and canSignal and locOkOB and not bounceBanLong

// 4) Stacked option buy - bar proxy for 3+ 1:3 buy imbs, sell side ~0, first candle, lower half
sellTiny = sellV <= math.max(1.0, buyV * 0.15)
buyTiny = buyV <= math.max(1.0, sellV * 0.15)
imbBuyBar = buyV > 0 and (sellTiny or (sellV > 0 and buyV >= sellV * imbRatio))
imbSellBar = sellV > 0 and (buyTiny or (buyV > 0 and sellV >= buyV * imbRatio))
stackBuyRun = stackNeed <= 1 ? imbBuyBar : stackNeed <= 2 ? (imbBuyBar and imbBuyBar[1]) : (imbBuyBar and imbBuyBar[1] and imbBuyBar[2])
stackSellRun = stackNeed <= 1 ? imbSellBar : stackNeed <= 2 ? (imbSellBar and imbSellBar[1]) : (imbSellBar and imbSellBar[1] and imbSellBar[2])
stackBuyStart = stackNeed <= 2 ? not imbBuyBar[2] : not imbBuyBar[3]
stackSellStart = stackNeed <= 2 ? not imbSellBar[2] : not imbSellBar[3]
stBuy = enableST and inSess and canSignal and stackBuyRun and stackBuyStart and math.abs(minD) <= nearZ and lowerHalf and bigOrder
stSell = enableST and inSess and canSignal and stackSellRun and stackSellStart and math.abs(maxD) <= nearZ and upperHalf and bigOrder

// Combined BUY/SELL only (video DD primary + rare FD). Closed 5m via [1]+offset.
// No separate BUY FD/SELL FD spray. No bgcolor. No static/var/barstate/force_overlay.
anyBuy = ddBuy or fdBuy
anySell = ddSell or fdSell
anySig = anyBuy or anySell
buyClose = anyBuy[1]
sellClose = anySell[1]
buyPulse = buyClose and not buyClose[1]
sellPulse = sellClose and not sellClose[1]

plotshape(buyClose, title="Buy", shape=shape.triangleup, location=location.belowbar, color=color.lime, offset=-1, size=size.large, text="BUY")
plotshape(sellClose, title="Sell", shape=shape.triangledown, location=location.abovebar, color=color.red, offset=-1, size=size.large, text="SELL")

plot(fib6, title="Fib 0.6", color=color.orange)
plot(fib7, title="Fib 0.7", color=color.yellow)

// Lipi alertcondition message must be const string (no syminfo concat). Pick the
// Nifty or BN alert on each chart — only the matching isBN branch ever fires.
alertcondition(buyPulse and isBN, title = "AK07 Buy BN", message = "AK07|OF|BUY|BANKNIFTY-I|5")
alertcondition(buyPulse and not isBN, title = "AK07 Buy Nifty", message = "AK07|OF|BUY|NIFTY-I|5")
alertcondition(sellPulse and isBN, title = "AK07 Sell BN", message = "AK07|OF|SELL|BANKNIFTY-I|5")
alertcondition(sellPulse and not isBN, title = "AK07 Sell Nifty", message = "AK07|OF|SELL|NIFTY-I|5")
