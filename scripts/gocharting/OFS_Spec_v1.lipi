indicator("OFS DD v1", overlay = true)

// Orderflow Delta-Divergence (DD) ONLY — GoCharting Lipi overlay
// Buy/Sell fire ONLY inside a pullback / retracement of the active leg:
//   - BUY  = bullish DD while price is in the up-leg 0.6-0.7 Fib pullback (or a dip to the leg low)
//   - SELL = bearish DD while price is in the down-leg 0.6-0.7 Fib retracement (or a bounce to the leg high)
// CONFIRMED only after the 5m bar closes. No broker orders.

enableDD = input(true, title = "DD enable")
useSess = input(true, title = "Only signal 09:15-15:30")
banWrongEdge = input(true, title = "Never BUY day-high / never SELL day-low")

zAbs = input(600.0, title = "DD Z |extreme| near-zero")
locTolPts = input(25.0, title = "Location touch pts")
breachPts = input(5.0, title = "Breach pts for edge/extreme")
runFibMin = input(3.0, title = "Min same-color bars in a leg")
fibPadPts = input(0.0, title = "Fib 0.6-0.7 zone pad pts (0=use locTol)")

d = orderflow.delta
maxD = orderflow.maxdelta
minD = orderflow.mindelta

bull = close > open
bear = close < open
doji = close == open
tick = 0.05
rng = math.max(high - low, tick)
isBN = close > 40000
locTol = locTolPts > 0.0 ? (isBN ? locTolPts * 1.6 : locTolPts) : 0.0
breach = breachPts > 0.0 ? (isBN ? breachPts * 1.6 : breachPts) : tick
fibPad = fibPadPts > 0.0 ? (isBN ? fibPadPts * 1.6 : fibPadPts) : locTol
zUse = isBN ? zAbs * 2.0 : zAbs

inSess = not useSess or (hour == 9 and minute >= 15) or (hour > 9 and hour < 15) or (hour == 15 and minute <= 30)

// Today-so-far high/low (only used for the "wrong edge" safety guard).
priorHi = low
priorLo = high
nPrior = 0.0
for i = 1 to 80 {
    if dayofweek[i] == dayofweek {
        nPrior := nPrior + 1.0
        if high[i] > priorHi {
            priorHi := high[i]
        }
        if low[i] < priorLo {
            priorLo := low[i]
        }
    }
}
hasPrior = nPrior >= 1.0
atHiEdge = hasPrior and locTol > 0.0 and math.abs(high - priorHi) <= locTol
atLoEdge = hasPrior and locTol > 0.0 and math.abs(low - priorLo) <= locTol
newExtHi = hasPrior and high > priorHi + breach
newExtLo = hasPrior and low < priorLo - breach

// L04 / P07: unroll close[1]..[8] to size the current up/down leg (dojis break a run).
u1 = close[1] > open[1]
u2 = u1 and close[2] > open[2]
u3 = u2 and close[3] > open[3]
u4 = u3 and close[4] > open[4]
u5 = u4 and close[5] > open[5]
u6 = u5 and close[6] > open[6]
u7 = u6 and close[7] > open[7]
u8 = u7 and close[8] > open[8]
upLen = u8 ? 8.0 : u7 ? 7.0 : u6 ? 6.0 : u5 ? 5.0 : u4 ? 4.0 : u3 ? 3.0 : u2 ? 2.0 : u1 ? 1.0 : 0.0
upHi = high[1]
upLo = low[1]
upHi := u2 ? math.max(upHi, high[2]) : upHi
upLo := u2 ? math.min(upLo, low[2]) : upLo
upHi := u3 ? math.max(upHi, high[3]) : upHi
upLo := u3 ? math.min(upLo, low[3]) : upLo
upHi := u4 ? math.max(upHi, high[4]) : upHi
upLo := u4 ? math.min(upLo, low[4]) : upLo
upHi := u5 ? math.max(upHi, high[5]) : upHi
upLo := u5 ? math.min(upLo, low[5]) : upLo
upHi := u6 ? math.max(upHi, high[6]) : upHi
upLo := u6 ? math.min(upLo, low[6]) : upLo
upHi := u7 ? math.max(upHi, high[7]) : upHi
upLo := u7 ? math.min(upLo, low[7]) : upLo
upHi := u8 ? math.max(upHi, high[8]) : upHi
upLo := u8 ? math.min(upLo, low[8]) : upLo
d1 = close[1] < open[1]
d2 = d1 and close[2] < open[2]
d3 = d2 and close[3] < open[3]
d4 = d3 and close[4] < open[4]
d5 = d4 and close[5] < open[5]
d6 = d5 and close[6] < open[6]
d7 = d6 and close[7] < open[7]
d8 = d7 and close[8] < open[8]
dnLen = d8 ? 8.0 : d7 ? 7.0 : d6 ? 6.0 : d5 ? 5.0 : d4 ? 4.0 : d3 ? 3.0 : d2 ? 2.0 : d1 ? 1.0 : 0.0
dnHi = high[1]
dnLo = low[1]
dnHi := d2 ? math.max(dnHi, high[2]) : dnHi
dnLo := d2 ? math.min(dnLo, low[2]) : dnLo
dnHi := d3 ? math.max(dnHi, high[3]) : dnHi
dnLo := d3 ? math.min(dnLo, low[3]) : dnLo
dnHi := d4 ? math.max(dnHi, high[4]) : dnHi
dnLo := d4 ? math.min(dnLo, low[4]) : dnLo
dnHi := d5 ? math.max(dnHi, high[5]) : dnHi
dnLo := d5 ? math.min(dnLo, low[5]) : dnLo
dnHi := d6 ? math.max(dnHi, high[6]) : dnHi
dnLo := d6 ? math.min(dnLo, low[6]) : dnLo
dnHi := d7 ? math.max(dnHi, high[7]) : dnHi
dnLo := d7 ? math.min(dnLo, low[7]) : dnLo
dnHi := d8 ? math.max(dnHi, high[8]) : dnHi
dnLo := d8 ? math.min(dnLo, low[8]) : dnLo
upLeg = upLen >= runFibMin
dnLeg = dnLen >= runFibMin
upRng = math.max(upHi - upLo, tick)
dnRng = math.max(dnHi - dnLo, tick)
fib6u = upHi - 0.6 * upRng
fib7u = upHi - 0.7 * upRng
fib6d = dnLo + 0.6 * dnRng
fib7d = dnLo + 0.7 * dnRng

// PULLBACK / RETRACEMENT zone = price sitting inside the 0.6-0.7 Fib band of the active leg.
inFibUp = upLeg and close <= math.max(fib6u, fib7u) + fibPad and close >= math.min(fib6u, fib7u) - fibPad
inFibDn = dnLeg and close <= math.max(fib6d, fib7d) + fibPad and close >= math.min(fib6d, fib7d) - fibPad

// L05 dip/bounce vs the frozen leg origin (current bar + last pullback bar).
pbLo = math.min(low, low[1])
pbHi = math.max(high, high[1])
bullDip = locTol > 0.0 and upLeg and (bear or close[1] < open[1]) and pbLo >= upLo - locTol and math.abs(low - pbLo) <= locTol
bearDip = locTol > 0.0 and dnLeg and (bull or close[1] > open[1]) and pbHi <= dnHi + locTol and math.abs(high - pbHi) <= locTol

// ONLY pullback/retracement locations qualify (no edge / sweep / new-extreme signals).
pullbackLong = inFibUp or bullDip
pullbackShort = inFibDn or bearDip

// DD polarity: bullish DD is a low/dip pullback; bearish DD is a high/rally retracement.
buyAtHigh = atHiEdge or newExtHi
sellAtLow = atLoEdge or newExtLo
ddBuyPass = enableDD and inSess and bull and d < 0.0 and minD < 0.0 and math.abs(maxD) <= zUse and zAbs > 0.0 and pullbackLong and not doji and d != 0.0 and not (banWrongEdge and buyAtHigh)
ddSellPass = enableDD and inSess and bear and d > 0.0 and maxD > 0.0 and math.abs(minD) <= zUse and zAbs > 0.0 and pullbackShort and not doji and d != 0.0 and not (banWrongEdge and sellAtLow)

confBuy = ddBuyPass
confSell = ddSellPass
conflict = confBuy and confSell
buySig = confBuy and not conflict
sellSig = confSell and not conflict
buyClose = buySig[1]
sellClose = sellSig[1]
buyPulse = buyClose and not buyClose[1]
sellPulse = sellClose and not sellClose[1]

plotshape(buyClose, title = "Buy", shape = shape.triangleup, location = location.belowbar, color = color.lime, offset = -1, size = size.large, text = "BUY")
plotshape(sellClose, title = "Sell", shape = shape.triangledown, location = location.abovebar, color = color.red, offset = -1, size = size.large, text = "SELL")

plot(inFibUp ? fib6u : (inFibDn ? fib6d : na), title = "Fib 0.6", color = color.orange)
plot(inFibUp ? fib7u : (inFibDn ? fib7d : na), title = "Fib 0.7", color = color.yellow)

alertcondition(buyPulse and isBN, title = "OFS DD Buy BN", message = "OFS|DD|BUY|BANKNIFTY-I|5")
alertcondition(buyPulse and not isBN, title = "OFS DD Buy Nifty", message = "OFS|DD|BUY|NIFTY-I|5")
alertcondition(sellPulse and isBN, title = "OFS DD Sell BN", message = "OFS|DD|SELL|BANKNIFTY-I|5")
alertcondition(sellPulse and not isBN, title = "OFS DD Sell Nifty", message = "OFS|DD|SELL|NIFTY-I|5")
