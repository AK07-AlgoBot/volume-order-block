[Unit]
Description=AK07 SEBI egress CONNECT proxy (95.216.179.8)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/volume-order-block
ExecStart=/usr/bin/python3 /root/volume-order-block/scripts/egress_bind_proxy.py --bind 95.216.179.8 --listen 0.0.0.0:18902
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
